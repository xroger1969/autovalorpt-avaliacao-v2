{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Comparador Auto Pro - Memory Rule",
  "type": "object",
  "required": ["rule_type", "statement", "scope", "effect"],
  "properties": {
    "rule_type": {
      "enum": ["liquidity", "technical_risk", "commercial_preference", "margin_cost"]
    },
    "statement": { "type": "string" },
    "scope": {
      "type": "object",
      "properties": {
        "make": { "type": ["string", "null"] },
        "model": { "type": ["string", "null"] },
        "generation": { "type": ["string", "null"] },
        "trim": { "type": ["string", "null"] },
        "year_min": { "type": ["integer", "null"] },
        "year_max": { "type": ["integer", "null"] },
        "mileage_min": { "type": ["integer", "null"] },
        "mileage_max": { "type": ["integer", "null"] }
      },
      "additionalProperties": false
    },
    "effect": {
      "type": "object",
      "description": "Impacto permitido no risco, liquidez, margem ou custo. Nunca reescreve diretamente o valor de mercado sem evidência.",
      "additionalProperties": true
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "valid_until": { "type": ["string", "null"], "format": "date-time" }
  },
  "additionalProperties": false
}
